{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hokkien Script",
  "scopeName": "source.khanina",
  "fileTypes": ["khanina"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#function-declaration" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtin" },
    { "include": "#number" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.khanina",
      "match": "(//).*$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.khanina" }
      }
    },
    "string": {
      "name": "string.quoted.double.khanina",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.khanina" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.khanina" }
      },
      "patterns": [
        { "name": "constant.character.escape.khanina", "match": "\\\\[\"\\\\nt]" },
        { "name": "invalid.illegal.unknown-escape.khanina", "match": "\\\\." }
      ]
    },
    "function-declaration": {
      "match": "\\b(co)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.khanina" },
        "2": { "name": "entity.name.function.khanina" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.khanina",
          "match": "\\bna[ \\t]+bo[ \\t]+na[ \\t]+si\\b|\\bna[ \\t]+si\\b|\\bna[ \\t]+bo\\b"
        },
        { "name": "keyword.control.loop.khanina", "match": "\\b(?:koh|cau|tiau[ \\t]+ke)\\b" },
        { "name": "keyword.control.flow.return.khanina", "match": "\\btui\\b" },
        { "name": "storage.type.function.khanina", "match": "\\bco\\b" },
        { "name": "storage.type.khanina", "match": "\\b(?:u|be[ \\t]+pian)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.false.khanina", "match": "\\bem[ \\t]+si\\b" },
        { "name": "constant.language.boolean.true.khanina", "match": "\\bsi\\b" },
        { "name": "constant.language.null.khanina", "match": "\\bbo\\b" }
      ]
    },
    "builtin": {
      "name": "support.function.builtin.khanina",
      "match": "\\bkong\\b"
    },
    "number": {
      "name": "constant.numeric.khanina",
      "match": "\\b\\d+(?:\\.\\d+)?\\b"
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=[ \\t]*\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.khanina" }
      }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.khanina", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.khanina", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.khanina", "match": "=" },
        { "name": "keyword.operator.arithmetic.khanina", "match": "[-+*/%]" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.khanina", "match": "," },
        { "name": "punctuation.terminator.statement.khanina", "match": ";" },
        { "name": "punctuation.section.block.begin.khanina", "match": "\\{" },
        { "name": "punctuation.section.block.end.khanina", "match": "\\}" },
        { "name": "punctuation.section.parens.begin.khanina", "match": "\\(" },
        { "name": "punctuation.section.parens.end.khanina", "match": "\\)" }
      ]
    }
  }
}
